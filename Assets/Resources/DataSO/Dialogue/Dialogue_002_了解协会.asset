  speakerPos: "\u5192\u9669\u5BB6\u534F\u4F1A\u63A5\u5F85\u5458"
  dialogueText: "\u5192\u9669\u5BB6\u534F\u4F1A\u662F\u63D0\u74E6\u7279\u5927\u9646\u6700\u53E4\u8001\u7684\u7EC4\u7EC7\u4E4B\u4E00\u3002\u6211\u4EEC\u8D1F\u8D23\u53D1\u5E03\u59D4\u6258\u3001\u7BA1\u7406\u5192\u9669\u5BB6\u7684\u7B49\u7EA7\u548C\u8BB0\u5F55\u3002\u5982\u679C\u4F60\u6709\u5174\u8DA3\uFF0C\u53EF\u4EE5\u53BB\u95E8\u53E3\u7684\u544A\u793A\u724C\u67E5\u770B\u6BCF\u65E5\u59D4\u6258\uFF0C\u6216\u8005\u53BB\u8499\u5FB7\u57CE\u627E\u5176\u4ED6\u5192\u9669\u5BB6\u4EA4\u6D41\u7ECF\u9A8C\u3002"
  options:
  - optionText: "\u542C\u8D77\u6765\u4E0D\u9519\uFF0C\u6211\u8003\u8651\u4E00\u4E0B"
