# ========== Unity 生成的缓存目录 ==========
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# ========== IDE / 编辑器缓存 ==========
.vs/
.vscode/
.gradle/

# ========== 自动生成的工程文件 ==========
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
sysinfo.txt

# ========== 打包产物 ==========
*.apk
*.aab
*.unitypackage
*.app

# ========== 核心：只保留C#代码 ==========
# 第1步：忽略 Assets 下所有文件和目录
Assets/**/*

# 第2步：关键！把所有子目录救回来（让Git能进去找文件）
!Assets/**/

# 第3步：只把 Scripts 文件夹里的 C# 脚本救回来
!Assets/Scripts/
!Assets/Scripts/**/
!Assets/Scripts/**/*.cs
!Assets/Scripts/**/*.cs.meta

# ========== 保留项目设置和包（建议留着） ==========
!/[Pp]rojectSettings/
!/[Pp]ackages/