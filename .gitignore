# ========== Unity 生成的缓存目录（必须忽略） ==========
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# ========== IDE / 编辑器缓存 ==========
.vs/
.vscode/
.gradle/

# ========== 工程文件（自动生成的） ==========
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
sysinfo.txt

# ========== 打包产物 ==========
*.apk
*.aab
*.unitypackage
*.app

# ========== 忽略所有资源文件（场景、材质、图片、预制体等） ==========
*.unity
*.controller
*.prefab
*.mat
*.asset
*.anim
*.overrideController
*.inputactions
*.spriteatlas
*.png
*.jpg
*.jpeg
*.fbx
*.wav
*.mp3
*.ogg
*.ttf
*.shader
*.cginc

# ========== 关键：先忽略所有 .meta 文件 ==========
*.meta

# ========== 然后再把 C# 脚本和它的 meta "救回来" ==========
!*.cs
!*.cs.meta

# ========== 可选：保留 ProjectSettings 和 Packages（团队项目建议打开） ==========
# 如果你是团队协作，把下面两行的 # 删掉
# !/[Pp]rojectSettings/
# !/[Pp]ackages/