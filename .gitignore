# ========== Unity 生成的缓存目录 ==========
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# ========== IDE / 编辑器缓存 ==========
.vs/
.vscode/
.gradle/

# ========== 自动生成的工程文件 ==========
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
sysinfo.txt

# ========== 打包产物 ==========
*.apk
*.aab
*.unitypackage
*.app

# ========== 关键：忽略 Assets 下所有文件 ==========
Assets/**/*

# ========== 然后只把 C# 脚本和它的 meta 救回来 ==========
!Assets/**/*.cs
!Assets/**/*.cs.meta

# ========== 保留 ProjectSettings 和 Packages（团队项目需要，个人可删） ==========
!/[Pp]rojectSettings/
!/[Pp]ackages/